# ==============================================================================
# Fraud Detection System (FDS) - Environment Configuration Template
# Author: Alpha
# Note: Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Settings
FLASK_ENV=production
FLASK_APP=app:create_app
SECRET_KEY=alpha_fds_default_insecure_secret_key_change_in_prod_12345
PORT=5000
DEBUG=False

# JWT Authentication
JWT_SECRET_KEY=alpha_fds_jwt_super_secret_signing_key_change_in_prod_67890
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://alpha_user:alpha_password@localhost:5432/fraud_detection_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=Fraud_Detection_IsolationForest

# Model Artifacts Path
MODEL_ARTIFACTS_DIR=ml/artifacts
DEFAULT_MODEL_VERSION=v1.0.0

# Rate Limiting
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_PREDICT=30 per second

# Risk Thresholding Defaults
ANOMALY_CONTAMINATION=0.005
CRITICAL_RISK_THRESHOLD=85.0
HIGH_RISK_THRESHOLD=70.0
MEDIUM_RISK_THRESHOLD=45.0
